# =====================================================================
# Application Configuration
# =====================================================================
APP_NAME="Yahoo-Finance-AI-Dashboard"
ENV="development"
DEBUG=True

# =====================================================================
# Database Configuration (SQLite / SQLAlchemy)
# =====================================================================
# Local file-based SQLite database URL
DATABASE_URL="sqlite:///./app.db"

# =====================================================================
# JWT Authentication & Security
# =====================================================================
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =====================================================================
# LLM & Vector Database Settings (Google Gemini & ChromaDB)
# =====================================================================
# Google AI Studio API Key for Gemini API calls
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# ChromaDB persistence directory and embedding settings
CHROMA_PERSIST_DIRECTORY="./chroma_db"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# =====================================================================
# Backend / API Settings
# =====================================================================
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# =====================================================================
# Streamlit Frontend Configuration
# =====================================================================
# Endpoint URL used by Streamlit to communicate with the FastAPI backend
API_BASE_URL="http://localhost:8000"